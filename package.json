{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "validate-db": "npx tsx scripts/validate_database_environment.ts",
    "start": "node --import tsx scripts/run_bfmr.ts",
    "supervise": "node --import tsx scripts/supervise_worker.ts",
    "health": "node --import tsx scripts/health_check.ts",
    "cutover": "node --import tsx scripts/run_production_cutover.ts",
    "optimize-db": "node --import tsx scripts/apply_database_optimizations.ts",
    "test": "node --import tsx --test tests/delivery_cutoff.test.ts tests/payment_intake.test.ts tests/informational_and_checkout_payout.test.ts tests/database_validator.test.ts tests/milestone5_operations.test.ts tests/cutover.test.ts tests/optimizations.test.ts",
    "recovery:diagnose": "node --import tsx scripts/diagnose_recovery.ts",
    "recovery:report": "node --import tsx scripts/reconcile_deal_email.ts",
    "unblock": "node --import tsx scripts/reconcile_incident.ts",
    "test:recovery": "node --import tsx tests/review_fixes.test.ts && node --import tsx tests/recovery_operations.test.ts",
    "typecheck:recovery": "tsc --project tsconfig.recovery.json --noEmit",
    "inspect-email": "node --import tsx scripts/inspect_deal_email.ts",
    "test:database-selection": "node --import tsx tests/database_selection.test.ts && node --import tsx tests/database_validator.test.ts",
    "database:target": "node --import tsx scripts/database_target.ts",
    "database:clone-test": "bash scripts/clone_test_database.sh",
    "start:prod": "node --import tsx scripts/environment_command.ts production run_bfmr",
    "supervise:prod": "node --import tsx scripts/environment_command.ts production supervise_worker",
    "health:prod": "node --import tsx scripts/environment_command.ts production health_check",
    "config:prod": "node --import tsx scripts/environment_command.ts production database_target",
    "start:test": "node --import tsx scripts/environment_command.ts testing run_bfmr",
    "supervise:test": "node --import tsx scripts/environment_command.ts testing supervise_worker",
    "health:test": "node --import tsx scripts/environment_command.ts testing health_check",
    "config:test": "node --import tsx scripts/environment_command.ts testing database_target",
    "database:clone-test:remote": "node --import tsx scripts/clone_test_database.ts",
    "test:environment-isolation": "node --import tsx tests/environment_isolation.test.ts && node --import tsx tests/database_clone.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@google-cloud/pubsub": "^6.3.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "googleapis": "^187.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
