{
  "name": "bfmr-automation-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "start": "node --import tsx scripts/run_bfmr.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:gmail-intake": "node --import tsx --test --test-isolation=none tests/gmail_push_transport.test.ts tests/postgres_gmail_intake.test.ts tests/production_gmail_intake.test.ts tests/gmail_intake_integration.test.ts",
    "test-amazon-purchase": "tsx scripts/test_amazon_purchase.ts",
    "test-bfmr-ipad-reservation": "tsx scripts/test_bfmr_ipad_reservation.ts",
    "test-amazon-checkout": "tsx scripts/test_amazon_checkout.ts",
    "inspect-tracker-api": "tsx scripts/inspect_tracker_api.ts",
    "inspect-bfmr-identity": "node --import tsx scripts/inspect_bfmr_identity.ts",
    "wait-for-email": "tsx scripts/wait_for_email.ts",
    "test-real-email": "tsx scripts/test_real_email_e2e.ts",
    "test-real-email-e2e": "tsx scripts/test_real_email_e2e.ts",
    "test-multi-deal-pdf": "node --import tsx scripts/test_multi_deal_pdf.ts",
    "resume-watch-series-reservation": "tsx scripts/resume_watch_series_reservation.ts",
    "auth-bfmr": "tsx scripts/auth_bfmr.ts",
    "debug-email": "tsx scripts/debug_gmail_intake.ts",
    "auth-gmail": "tsx scripts/auth_gmail_oauth.ts",
    "typecheck:all": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution bundler --esModuleInterop --skipLibCheck scripts/*.ts tests/*.ts",
    "test:relational": "node --import tsx tests/relational_integration.test.ts"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^6.2.0",
    "dotenv": "^18.0.6",
    "googleapis": "^185.0.0",
    "imapflow": "^2.3.0",
    "pg": "^8.23.1",
    "playwright": "^1.64.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.23.1",
    "pdf-parse": "^2.4.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
