# Copy to private .env.testing. Fill with separate test accounts, never prod secrets.
# Start/configure via npm run start:test / npm run config:test.
BFMR_INTAKE_MODE=testing
DATABASE_URL_TEST=
# Optional production URL permits same-target/runtime-user comparisons; never use it for test writes.
DATABASE_URL_PRODUCTION=
# Production identity strings (no passwords) are required to rule out reused accounts.
BFMR_EXPECTED_ACCOUNT_PRODUCTION=
GMAIL_ACCOUNT_EMAIL_PRODUCTION=
AMAZON_EXPECTED_ACCOUNT_PRODUCTION=

BFMR_EXPECTED_ACCOUNT_TEST=
BFMR_API_KEY_TEST=
BFMR_API_SECRET_TEST=
BFMR_TRACKER_URL_TEST=
BFMR_TRACKER_BROWSER_URL_TEST=
BFMR_ACCOUNT_IDENTITY_SELECTOR_TEST=
BFMR_ACCOUNT_RESERVATION_SELECTOR_TEST=
BFMR_ACCOUNT_PROOF_RESERVE_ID_TEST=
GMAIL_ACCOUNT_EMAIL_TEST=
GMAIL_CLIENT_ID_TEST=
GMAIL_CLIENT_SECRET_TEST=
GMAIL_REFRESH_TOKEN_TEST=
GOOGLE_PUBSUB_TOPIC_TEST=
GOOGLE_PUBSUB_SUBSCRIPTION_TEST=
GOOGLE_APPLICATION_CREDENTIALS_TEST=
TELEGRAM_BOT_TOKEN_TEST=
TELEGRAM_CHAT_ID_TEST=
AMAZON_EXPECTED_ACCOUNT_TEST=
AMAZON_ACCOUNT_IDENTITY_CONTRACT_VALIDATED_TEST=
AMAZON_ACCOUNT_IDENTITY_SELECTOR_TEST=
AMAZON_DEFAULT_CARD_TEST=
AMAZON_EXPECTED_CARD_LAST4_TEST=
AMAZON_EXPECTED_DELIVERY_FRAGMENT_TEST=
BFMR_AMAZON_POLICY_APPROVED_TEST=
BFMR_CREATION_TERMS_CONTRACT_VALIDATED_TEST=
BFMR_OPEN_EXPOSURE_CONTRACT_VALIDATED_TEST=

# Defaults isolate state/profile/heartbeat/backups; override only with distinct absolute paths.
# BFMR_STATE_DIR_TEST=/private/test/state
# CHROMIUM_PROFILE_PATH_TEST=/private/test/chromium-profile
# BFMR_BACKUP_DIR_TEST=/private/test/backups
PLAYWRIGHT_HEADLESS=false
