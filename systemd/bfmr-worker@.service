[Unit]
Description=BFMR %i worker
After=network-online.target postgresql.service docker.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

# Instances: production and testing. Provision separate OS users and private
# /etc/bfmr/production.env and /etc/bfmr/testing.env first. See DATABASE_MODES.md.
[Service]
Type=simple
User=bfmr-%i
Group=bfmr-%i
WorkingDirectory=/opt/bfmr/BFMR-Automation-v2
Environment=HOME=/var/lib/bfmr-%i
Environment=BFMR_ENV_FILE=/etc/bfmr/%i.env
EnvironmentFile=/etc/bfmr/%i.env
ExecStart=/usr/bin/node --import tsx scripts/environment_command.ts %i supervise_worker
StateDirectory=bfmr-%i
StateDirectoryMode=0700
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=control-group
SyslogIdentifier=bfmr-%i
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
