# BFMR Automation v2 — complete configuration template
# Keep real values in a private .env; never commit or paste that file.
# If .env already exists, merge missing entries; preserve existing API keys.
# Empty required values must be filled in. Optional settings are commented out.
# Paths must be Ubuntu/container paths, not Windows paths. No ~ expansion.
# Existing shell variables win over values loaded from files.

# 1. REQUIRED FOR THE READ-ONLY BFMR ACCOUNT-ALIGNMENT DIAGNOSTIC
BFMR_API_KEY=
BFMR_API_SECRET=
BFMR_EXPECTED_ACCOUNT=
# Exact documented HTTPS My Tracker API endpoint on api.bfmr.com.
# Use a bare endpoint with no search/status/date/pagination query or fragment.
BFMR_TRACKER_URL=
# Actual signed-in browser My Tracker URL, on the same BFMR origin as its tab.
BFMR_TRACKER_BROWSER_URL=
# Verified CSS selector for ONE visible account identity field containing
# exactly BFMR_EXPECTED_ACCOUNT. Do not guess a selector or use general text.
BFMR_ACCOUNT_IDENTITY_SELECTOR=
# An EXISTING reservation visible in BOTH browser and the complete API read.
BFMR_ACCOUNT_PROOF_RESERVE_ID=
# Verified CSS selector for reservation rows carrying data-reserve-id and
# data-deal-id. The configured proof must match one visible row exactly.
BFMR_ACCOUNT_RESERVATION_SELECTOR=

# 2. BROWSER / CONFIGURATION LOADING
# Supply the PID of the already-running dedicated Chromium browser, or pass
# --browser-pid <PID> to the diagnostic. Leave this commented if not configured:
# an active BFMR_CHROMIUM_PID= with an empty value is invalid.
# BFMR_CHROMIUM_PID=
# Optional persistent profile override for other browser commands.
# CHROMIUM_PROFILE_PATH=/home/bfmr/.config/bfmr/chromium-profile
PLAYWRIGHT_HEADLESS=false
# Set this in the shell BEFORE launching Node to select another private file;
# setting it inside .env cannot select a file retroactively.
# BFMR_ENV_FILE=/absolute/container/path/to/private.env

# 3. RELATIONAL BUSINESS STORE — not required for the identity diagnostic
# Use the intended PostgreSQL database and a reviewed non-owning runtime role.
# Container-local localhost is NOT the separate PostgreSQL container.
DATABASE_URL=
# Existing approved Amazon retailer_accounts row and its exact stored email.
BFMR_RETAILER_ACCOUNT_ID=
BFMR_RETAILER_ACCOUNT_EMAIL=

# 4. ACTIVE GMAIL API HISTORY RUNNER — OAuth credentials for that mailbox
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
BFMR_INTAKE_MODE=production

# 5. TELEGRAM ALERTS — needed by workflows that require alert delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 6. AMAZON CHECKOUT — required by the purchase workflow, not the diagnostic
# A private identifying fragment of the intended selected delivery address.
AMAZON_EXPECTED_DELIVERY_FRAGMENT=
AMAZON_EXPECTED_CARD_LAST4=
# SECRET: current legacy name for card CVV, NOT a card number or card alias.
# Preserve leading zeros. Never place real values in this example or logs.
AMAZON_DEFAULT_CARD=

# 7. CONTRACT / ACTION GATES — deliberately UNSET until individually verified
# Uncomment/set YES only after the relevant verified evidence and authorization.
# Populating credentials or this template does not authorize provider actions.
# BFMR_CREATION_TERMS_CONTRACT_VALIDATED=
# BFMR_OPEN_EXPOSURE_CONTRACT_VALIDATED=
# BFMR_AMAZON_POLICY_APPROVED=
# FIRST-EVER Gmail queue creation only; remove after that initialization.
# Never use this to replace a lost queue, reset history or replay old mail.
# BFMR_INITIALIZE_GMAIL_QUEUE=

# 8. OPTIONAL PRIVATE STATE PATH OVERRIDES
# Default base: the current user's home + /.local/state/bfmr/.
# Keep durable/backed-up storage; do not recreate missing existing journals.
# BFMR_GMAIL_QUEUE_PATH=/home/bfmr/.local/state/bfmr/gmail-intake.json
# BFMR_MULTI_DEAL_STATE_PATH=/home/bfmr/.local/state/bfmr/multi-deal.json
# BFMR_STARTUP_STATE_PATH=/home/bfmr/.local/state/bfmr/startup-reservation.json
# BFMR_POST_RESERVATION_STATE_PATH=/home/bfmr/.local/state/bfmr/post-reservation.json
# BFMR_STATUS_SNAPSHOT_PATH=/home/bfmr/.local/state/bfmr/bfmr-status.json
# Preserved legacy/manual order ledger and accepted cutover hash source.
# The active email runner uses SQL business records after accepted cutover.
# BFMR_AMAZON_ORDER_LEDGER_PATH=/home/bfmr/.local/state/bfmr/amazon-orders.json

# 9. OPTIONAL ALTERNATE / DIAGNOSTIC EMAIL PATHS — not active runner requirements
# These existing script paths do not establish a deployed watch/PubSub service.
# GOOGLE_APPLICATION_CREDENTIALS=/home/bfmr/.bfmr/gcp-credentials.json
# GOOGLE_PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/YOUR_TOPIC
# GOOGLE_PUBSUB_SUBSCRIPTION=projects/YOUR_PROJECT/subscriptions/YOUR_SUBSCRIPTION
# GMAIL_ACCOUNT_EMAIL=
# GMAIL_USER_EMAIL=
# SECRET: Gmail app password for the alternate IMAP path, not OAuth password.
# GMAIL_APP_PASSWORD=
# IMAP_USER=
# IMAP_PASSWORD=
# Local inbound listener only; default 3005.
# INBOUND_PORT=3005

# 10. OPTIONAL OFFLINE / DISPOSABLE TEST CONFIGURATION
# Only a separately verified disposable native PostgreSQL database, never live.
# BFMR_TEST_DATABASE_URL=
# Normally unnecessary: tests default to bundled database/schema.sql.
# An override must be an identical reviewed schema and pass the pinned hash.
# BFMR_SCHEMA_SQL_PATH=/absolute/container/path/to/reviewed-schema.sql

# Host-managed variables such as HOME, DISPLAY and proxy settings are inherited;
# do not replace them here. No live workflow is enabled merely by this template.
